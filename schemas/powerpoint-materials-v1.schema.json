{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "powerpoint.materials/v1"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "path",
          "sha256"
        ]
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "file_id",
          "kind",
          "location"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "file_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "text",
              "table",
              "table_row",
              "cell",
              "image"
            ]
          },
          "location": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file_id",
          "severity",
          "code",
          "message"
        ],
        "properties": {
          "file_id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "blocking"
            ]
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "ready": {
      "type": "boolean"
    }
  },
  "required": [
    "schema",
    "files",
    "records",
    "issues",
    "ready"
  ]
}
