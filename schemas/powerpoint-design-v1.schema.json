{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "objective",
    "branding",
    "pages"
  ],
  "properties": {
    "schema": {
      "const": "powerpoint.design/v1"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "branding": {
      "enum": [
        "template",
        "custom"
      ]
    },
    "colors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9A-Fa-f]{6}$"
      }
    },
    "fonts": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "latin": {
          "type": "string",
          "minLength": 1
        },
        "east_asian": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "purpose",
          "focus",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "focus": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "cover",
              "content",
              "comparison",
              "process",
              "chart",
              "image",
              "closing",
              "other"
            ]
          },
          "density": {
            "enum": [
              "low",
              "normal",
              "high"
            ]
          },
          "must_keep": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
