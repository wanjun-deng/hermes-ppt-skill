{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.powerpoint-skill/schemas/powerpoint-edit-result-v1.schema.json",
  "title": "PowerPoint edit result v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "powerpoint.edit-result/v1"
    },
    "ok": {
