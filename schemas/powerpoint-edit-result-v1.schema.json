    },
    "replacements": {
      "type": "integer",
      "minimum": 0
    },
    "chart_updated": {
      "const": true
    },
    "image_swapped": {
      "const": true
    },
    "duplicated_to": {
      "type": "integer",
      "minimum": 0
    },
    "background_set": {
      "const": true
    },
    "hyperlinked_runs": {
      "type": "integer",
      "minimum": 0
    },
    "slide_number_enabled": {
      "type": "boolean"
    },
    "footer_set": {
      "const": true
    },
    "notes_set": {
      "const": true
    },
    "notes_appended": {
      "const": true
    },
    "slide_removed": {
