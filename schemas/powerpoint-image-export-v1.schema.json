{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.powerpoint-skill/schemas/powerpoint-image-export-v1.schema.json",
  "title": "PowerPoint image export manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ok",
    "template",
    "exports"
  ],
  "properties": {
    "schema": {
      "const": "powerpoint.image-export/v1"
    },
    "ok": {
      "const": true
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "exports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "slide_index": {
            "type": "integer",
            "minimum": 0
          },
          "shape_ref": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "placeholder": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "placeholder"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "shape_id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "path": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "required": [
                  "shape_id",
                  "path",
                  "name"
                ]
              }
            ]
          },
          "output": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "slide_index",
          "shape_ref",
          "output",
          "sha256",
          "size_bytes"
        ]
      }
    }
  }
}
